<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FuelTek Pro | Sistema de Órdenes de Trabajo</title>
    
    <!-- Fuentes e Iconos -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>
    
    <!-- Librerías Externas -->
    <script src="https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js"></script>
    
    <!-- Firebase SDK (Modular) -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/9.22.0/firebase-app.js";
        import { getFirestore, collection, doc, setDoc, getDoc, getDocs, deleteDoc } from "https://www.gstatic.com/firebasejs/9.22.0/firebase-firestore.js";
        window.firebaseApp = { initializeApp, getFirestore, collection, doc, setDoc, getDoc, getDocs, deleteDoc };
    </script>

    <style>
        :root {
            --bg-body: #f1f5f9;
            --bg-sidebar: #0f172a;
            --bg-card: #ffffff;
            --primary: #2563eb;
            --primary-hover: #1d4ed8;
            --accent: #f97316;
            --text-main: #1e293b;
            --text-muted: #64748b;
            --border: #e2e8f0;
            --success: #10b981;
            --danger: #ef4444;
            --warning: #f59e0b;
            --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
            --shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
            --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
            --radius: 0.75rem;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        
        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg-body);
            color: var(--text-main);
            height: 100vh;
            overflow: hidden;
        }

        /* LAYOUT PRINCIPAL */
        .app-container {
            display: flex;
            height: 100vh;
        }

        /* SIDEBAR */
        .sidebar {
            width: 260px;
            background: var(--bg-sidebar);
            color: white;
            display: flex;
            flex-direction: column;
            padding: 1.5rem;
            transition: transform 0.3s ease;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 2.5rem;
            padding-bottom: 1.5rem;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

        .brand img {
            width: 45px;
            height: 45px;
            object-fit: contain;
            background: white;
            border-radius: 8px;
            padding: 4px;
        }

        .brand-text h2 {
            font-size: 1.25rem;
            font-weight: 800;
            color: var(--accent);
            letter-spacing: -0.5px;
        }

        .brand-text p {
            font-size: 0.75rem;
            color: #94a3b8;
            font-weight: 500;
        }

        .nav-menu {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            flex: 1;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0.75rem 1rem;
            border-radius: var(--radius);
            color: #94a3b8;
            text-decoration: none;
            font-weight: 500;
            font-size: 0.9rem;
            transition: all 0.2s;
            cursor: pointer;
            border: none;
            background: none;
            width: 100%;
            text-align: left;
        }

        .nav-item:hover {
            background: rgba(255,255,255,0.05);
            color: white;
        }

        .nav-item.active {
            background: var(--primary);
            color: white;
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
        }

        .nav-item i { width: 20px; height: 20px; }

        .sidebar-footer {
            margin-top: auto;
            padding-top: 1rem;
            border-top: 1px solid rgba(255,255,255,0.1);
        }

        .sync-status {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.8rem;
            color: #94a3b8;
            padding: 8px;
            background: rgba(255,255,255,0.05);
            border-radius: 6px;
        }

        .sync-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--warning);
        }

        .sync-dot.online { background: var(--success); box-shadow: 0 0 8px var(--success); }

        /* MAIN CONTENT */
        .main-content {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .top-bar {
            height: 70px;
            background: var(--bg-card);
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 2rem;
        }

        .top-bar h1 {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--text-main);
        }

        .top-bar-actions {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .ot-badge {
            background: var(--accent);
            color: white;
            padding: 0.5rem 1rem;
            border-radius: var(--radius);
            font-weight: 700;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            gap: 8px;
            box-shadow: var(--shadow-sm);
        }

        .content-area {
            flex: 1;
            overflow-y: auto;
            padding: 2rem;
        }

        /* VISTAS */
        .view { display: none; animation: fadeIn 0.3s ease; }
        .view.active { display: block; }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* DASHBOARD CARDS */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .stat-card {
            background: var(--bg-card);
            padding: 1.5rem;
            border-radius: var(--radius);
            border: 1px solid var(--border);
            box-shadow: var(--shadow-sm);
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
        }

        .stat-info h3 {
            font-size: 0.875rem;
            color: var(--text-muted);
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

        .stat-info .value {
            font-size: 1.75rem;
            font-weight: 800;
            color: var(--text-main);
        }

        .stat-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
        }

        .stat-icon.blue { background: var(--primary); }
        .stat-icon.orange { background: var(--accent); }
        .stat-icon.green { background: var(--success); }
        .stat-icon.red { background: var(--danger); }

        /* FORMULARIOS MODERNOS */
        .card {
            background: var(--bg-card);
            border-radius: var(--radius);
            border: 1px solid var(--border);
            box-shadow: var(--shadow-sm);
            padding: 1.5rem;
            margin-bottom: 1.5rem;
        }

        .card-header {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 1.5rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid var(--border);
        }

        .card-header h3 {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--text-main);
        }

        .card-header i { color: var(--primary); }

        .form-grid {
            display: grid;
            gap: 1.25rem;
        }

        .grid-2 { grid-template-columns: repeat(2, 1fr); }
        .grid-3 { grid-template-columns: repeat(3, 1fr); }
        .grid-4 { grid-template-columns: repeat(4, 1fr); }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .form-group label {
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--text-main);
        }

        .form-group input,
        .form-group select,
        .form-group textarea {
            padding: 0.75rem 1rem;
            border: 1px solid var(--border);
            border-radius: 8px;
            font-size: 0.95rem;
            font-family: inherit;
            transition: all 0.2s;
            background: #fafafa;
        }

        .form-group input:focus,
        .form-group select:focus,
        .form-group textarea:focus {
            outline: none;
            border-color: var(--primary);
            background: white;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
        }

        textarea { min-height: 100px; resize: vertical; }

        /* ACCESORIOS */
        .accessory-category {
            border: 1px solid var(--border);
            border-radius: 8px;
            margin-bottom: 0.75rem;
            overflow: hidden;
        }

        .acc-header {
            background: #f8fafc;
            padding: 0.75rem 1rem;
            font-weight: 600;
            font-size: 0.9rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            user-select: none;
        }

        .acc-header:hover { background: #f1f5f9; }

        .acc-body {
            padding: 1rem;
            display: none;
            border-top: 1px solid var(--border);
        }

        .acc-body.active { display: block; }

        .checkbox-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
            gap: 0.75rem;
        }

        .checkbox-item {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 0.5rem;
            border-radius: 6px;
            cursor: pointer;
            transition: background 0.2s;
            font-size: 0.9rem;
        }

        .checkbox-item:hover { background: #f1f5f9; }
        .checkbox-item input { accent-color: var(--primary); width: 16px; height: 16px; }

        /* PAGO */
        .payment-summary {
            background: #f8fafc;
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 1.25rem;
        }

        .saldo-box {
            margin-top: 1rem;
            padding: 1rem;
            border-radius: 8px;
            font-weight: 700;
            text-align: center;
            font-size: 1.1rem;
        }

        .saldo-box.pending { background: #fef2f2; color: var(--danger); border: 1px solid #fecaca; }
        .saldo-box.paid { background: #f0fdf4; color: var(--success); border: 1px solid #bbf7d0; }

        /* BOTONES */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 0.75rem 1.5rem;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.2s;
            border: none;
        }

        .btn i { width: 18px; height: 18px; }

        .btn-primary { background: var(--primary); color: white; }
        .btn-primary:hover { background: var(--primary-hover); transform: translateY(-1px); box-shadow: var(--shadow); }

        .btn-success { background: var(--success); color: white; }
        .btn-success:hover { background: #059669; }

        .btn-danger { background: var(--danger); color: white; }
        .btn-danger:hover { background: #dc2626; }

        .btn-secondary { background: white; color: var(--text-main); border: 1px solid var(--border); }
        .btn-secondary:hover { background: #f8fafc; border-color: #cbd5e1; }

        .btn-group {
            display: flex;
            gap: 0.75rem;
            margin-top: 1.5rem;
            justify-content: flex-end;
        }

        /* TABLA DE HISTORIAL */
        .table-container {
            overflow-x: auto;
            border: 1px solid var(--border);
            border-radius: var(--radius);
            background: white;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.9rem;
        }

        th {
            background: #f8fafc;
            text-align: left;
            padding: 1rem;
            font-weight: 600;
            color: var(--text-muted);
            border-bottom: 1px solid var(--border);
            white-space: nowrap;
        }

        td {
            padding: 1rem;
            border-bottom: 1px solid var(--border);
            color: var(--text-main);
        }

        tr:hover td { background: #f8fafc; }

        .badge {
            padding: 0.25rem 0.75rem;
            border-radius: 9999px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .badge-pending { background: #fef2f2; color: var(--danger); }
        .badge-paid { background: #f0fdf4; color: var(--success); }
        .badge-partial { background: #fffbeb; color: var(--warning); }

        .action-btns {
            display: flex;
            gap: 0.5rem;
        }

        .action-btn {
            width: 32px;
            height: 32px;
            border-radius: 6px;
            border: 1px solid var(--border);
            background: white;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-muted);
            transition: all 0.2s;
        }

        .action-btn:hover { color: var(--primary); border-color: var(--primary); background: #eff6ff; }
        .action-btn.delete:hover { color: var(--danger); border-color: var(--danger); background: #fef2f2; }
        .action-btn i { width: 16px; height: 16px; }

        /* CONFIGURACIÓN TABS */
        .config-tabs {
            display: flex;
            gap: 0.5rem;
            margin-bottom: 1.5rem;
            border-bottom: 1px solid var(--border);
        }

        .tab-btn {
            padding: 0.75rem 1.25rem;
            background: none;
            border: none;
            border-bottom: 2px solid transparent;
            font-weight: 600;
            color: var(--text-muted);
            cursor: pointer;
            transition: all 0.2s;
        }

        .tab-btn.active {
            color: var(--primary);
            border-bottom-color: var(--primary);
        }

        .tab-content { display: none; }
        .tab-content.active { display: block; }

        .config-item {
            display: flex;
            gap: 0.75rem;
            margin-bottom: 0.75rem;
            align-items: center;
        }

        .config-item input {
            flex: 1;
            padding: 0.6rem;
            border: 1px solid var(--border);
            border-radius: 6px;
        }

        .btn-icon {
            width: 36px;
            height: 36px;
            border-radius: 6px;
            border: none;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .btn-icon.add { background: var(--success); color: white; }
        .btn-icon.remove { background: #fee2e2; color: var(--danger); }
        .btn-icon.remove:hover { background: var(--danger); color: white; }

        /* PRINT AREA */
        #printArea { display: none; }

        /* RESPONSIVE */
        @media (max-width: 1024px) {
            .grid-3, .grid-4 { grid-template-columns: repeat(2, 1fr); }
        }

        @media (max-width: 768px) {
            .app-container { flex-direction: column; height: auto; overflow: visible; }
            .sidebar { 
                width: 100%; 
                flex-direction: row; 
                align-items: center; 
                padding: 1rem; 
                position: sticky; 
                top: 0; 
                z-index: 50;
            }
            .brand { margin-bottom: 0; padding-bottom: 0; border-bottom: none; flex: 1; }
            .brand-text { display: none; }
            .nav-menu { 
                flex-direction: row; 
                overflow-x: auto; 
                padding-bottom: 0; 
                gap: 0.5rem;
            }
            .nav-item span { display: none; }
            .nav-item { padding: 0.5rem; justify-content: center; }
            .sidebar-footer { display: none; }
            .grid-2, .grid-3, .grid-4 { grid-template-columns: 1fr; }
            .content-area { padding: 1rem; }
            .top-bar { padding: 0 1rem; }
        }

        @media print {
            @page { size: letter; margin: 6mm; }
            body * { visibility: hidden; }
            #printArea, #printArea * { visibility: visible; }
            #printArea {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
                padding: 6mm;
                display: block !important;
                background: white;
            }
        }
    </style>
</head>
<body>

<div class="app-container">
    <!-- SIDEBAR -->
    <aside class="sidebar">
        <div class="brand">
            <img src="logo-fueltek.png" alt="FuelTek" onerror="this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2245%22 height=%2245%22><rect width=%2245%22 height=%2245%22 fill=%22%23f97316%22/><text x=%2250%%22 y=%2250%%22 dominant-baseline=%22middle%22 text-anchor=%22middle%22 fill=%22white%22 font-size=%2220%22 font-weight=%22bold%22>F</text></svg>'">
            <div class="brand-text">
                <h2>FUELTEK</h2>
                <p>Sistema de Gestión v3.0</p>
            </div>
        </div>

        <nav class="nav-menu">
            <button class="nav-item active" onclick="switchView('dashboard')">
                <i data-lucide="layout-dashboard"></i>
                <span>Dashboard</span>
            </button>
            <button class="nav-item" onclick="switchView('nueva-ot')">
                <i data-lucide="file-plus"></i>
                <span>Nueva Orden</span>
            </button>
            <button class="nav-item" onclick="switchView('historial')">
                <i data-lucide="list"></i>
                <span>Historial</span>
            </button>
            <button class="nav-item" onclick="switchView('configuracion')">
                <i data-lucide="settings"></i>
                <span>Configuración</span>
            </button>
        </nav>

        <div class="sidebar-footer">
            <div class="sync-status" id="syncStatus">
                <div class="sync-dot" id="syncDot"></div>
                <span id="syncText">Sincronizando...</span>
            </div>
        </div>
    </aside>

    <!-- MAIN CONTENT -->
    <main class="main-content">
        <header class="top-bar">
            <h1 id="viewTitle">Dashboard</h1>
            <div class="top-bar-actions">
                <div class="ot-badge">
                    <i data-lucide="hash" style="width:16px;height:16px;"></i>
                    <span>Próxima OT: <span id="nextOtDisplay">10725</span></span>
                </div>
            </div>
        </header>

        <div class="content-area">
            
            <!-- VISTA: DASHBOARD -->
            <div id="view-dashboard" class="view active">
                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-info">
                            <h3>Total Órdenes</h3>
                            <div class="value" id="statTotal">0</div>
                        </div>
                        <div class="stat-icon blue"><i data-lucide="file-text"></i></div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-info">
                            <h3>Pendientes de Pago</h3>
                            <div class="value" id="statPending">0</div>
                        </div>
                        <div class="stat-icon red"><i data-lucide="alert-circle"></i></div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-info">
                            <h3>Ingresos del Mes</h3>
                            <div class="value" id="statRevenue">$0</div>
                        </div>
                        <div class="stat-icon green"><i data-lucide="trending-up"></i></div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <i data-lucide="clock"></i>
                        <h3>Órdenes Recientes</h3>
                    </div>
                    <div class="table-container">
                        <table id="recentOrdersTable">
                            <thead>
                                <tr>
                                    <th>N° OT</th>
                                    <th>Cliente</th>
                                    <th>Equipo</th>
                                    <th>Estado</th>
                                    <th>Fecha</th>
                                </tr>
                            </thead>
                            <tbody id="recentOrdersBody">
                                <tr><td colspan="5" style="text-align:center;padding:2rem;color:var(--text-muted);">Cargando datos...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- VISTA: NUEVA OT -->
            <div id="view-nueva-ot" class="view">
                <form id="otForm">
                    <div class="card">
                        <div class="card-header">
                            <i data-lucide="user"></i>
                            <h3>Datos del Cliente</h3>
                        </div>
                        <div class="form-grid grid-3">
                            <div class="form-group">
                                <label>Nombre Completo *</label>
                                <input type="text" name="clienteNombre" required placeholder="Ej: Juan Pérez">
                            </div>
                            <div class="form-group">
                                <label>Teléfono *</label>
                                <input type="tel" name="clienteTelefono" required placeholder="+56 9 1234 5678">
                            </div>
                            <div class="form-group">
                                <label>Correo Electrónico</label>
                                <input type="email" name="clienteEmail" placeholder="cliente@email.com">
                            </div>
                            <div class="form-group">
                                <label>Fecha de Recepción *</label>
                                <input type="date" name="fechaRecibida" required>
                            </div>
                            <div class="form-group">
                                <label>Fecha Estimada de Entrega</label>
                                <input type="date" name="fechaEntrega">
                            </div>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header">
                            <i data-lucide="wrench"></i>
                            <h3>Datos de la Herramienta</h3>
                        </div>
                        <div class="form-grid grid-4">
                            <div class="form-group">
                                <label>Marca *</label>
                                <select name="marca" id="marcaSelect" required>
                                    <option value="">Seleccione...</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Modelo *</label>
                                <select name="modelo" id="modeloSelect" required>
                                    <option value="">Seleccione marca primero...</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label>N° de Serie</label>
                                <input type="text" name="serie" placeholder="Opcional">
                            </div>
                            <div class="form-group">
                                <label>Año de Fabricación</label>
                                <select name="anio" id="anioSelect">
                                    <option value="">Seleccione...</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header">
                            <i data-lucide="package-check"></i>
                            <h3>Revisión y Accesorios Recibidos</h3>
                        </div>
                        <div id="accessoriesContainer">
                            <!-- Generado dinámicamente -->
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header">
                            <i data-lucide="clipboard-list"></i>
                            <h3>Diagnóstico y Trabajo</h3>
                        </div>
                        <div class="form-grid grid-2">
                            <div class="form-group">
                                <label>Diagnóstico Inicial / Falla Reportada</label>
                                <textarea name="diagnostico" placeholder="Describa el problema..."></textarea>
                            </div>
                            <div class="form-group">
                                <label>Trabajo Realizado / Notas del Técnico</label>
                                <textarea name="trabajo" placeholder="Describa las reparaciones efectuadas..."></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header">
                            <i data-lucide="credit-card"></i>
                            <h3>Resumen de Pago</h3>
                        </div>
                        <div class="form-grid grid-3">
                            <div class="form-group">
                                <label>Valor del Trabajo (CLP) *</label>
                                <input type="text" id="valorTrabajoInput" name="valorTrabajo" required placeholder="$ 0">
                            </div>
                            <div class="form-group">
                                <label>Estado de Pago *</label>
                                <select name="estadoPago" id="estadoPago" required>
                                    <option value="Pendiente">Pendiente de Pago</option>
                                    <option value="Abonado">Abonado (Seña)</option>
                                    <option value="Pagado">Pagado Total</option>
                                </select>
                            </div>
                            <div class="form-group" id="labelAbonoGroup" style="display:none;">
                                <label>Monto Abonado (CLP)</label>
                                <input type="text" id="montoAbonadoInput" name="montoAbonado" placeholder="$ 0">
                            </div>
                        </div>
                        <div id="saldoDisplay" class="saldo-box pending" style="display:none;">
                            SALDO PENDIENTE: $<span id="saldoValue">0</span>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header">
                            <i data-lucide="pen-tool"></i>
                            <h3>Firmas de Conformidad</h3>
                        </div>
                        <div class="form-grid grid-2">
                            <div class="form-group">
                                <label>Nombre Técnico / Firma Taller</label>
                                <input type="text" name="firmaTaller" placeholder="Nombre completo">
                            </div>
                            <div class="form-group">
                                <label>Nombre Cliente / Firma Cliente</label>
                                <input type="text" name="firmaCliente" placeholder="Nombre completo">
                            </div>
                        </div>
                    </div>

                    <div class="btn-group">
                        <button type="button" class="btn btn-secondary" onclick="resetForm()">
                            <i data-lucide="rotate-ccw"></i> Limpiar
                        </button>
                        <button type="button" class="btn btn-success" onclick="saveOrder()">
                            <i data-lucide="save"></i> Guardar Orden
                        </button>
                    </div>
                </form>
            </div>

            <!-- VISTA: HISTORIAL -->
            <div id="view-historial" class="view">
                <div class="card">
                    <div class="card-header" style="justify-content: space-between;">
                        <div style="display:flex;align-items:center;gap:10px;">
                            <i data-lucide="search"></i>
                            <input type="text" id="searchHistorial" placeholder="Buscar por N° OT, cliente o marca..." style="padding:0.5rem 1rem;border:1px solid var(--border);border-radius:6px;width:300px;">
                        </div>
                        <button class="btn btn-primary" onclick="exportToExcel()">
                            <i data-lucide="download"></i> Exportar Excel
                        </button>
                    </div>
                    <div class="table-container">
                        <table>
                            <thead>
                                <tr>
                                    <th>N° OT</th>
                                    <th>Cliente</th>
                                    <th>Equipo</th>
                                    <th>Valor</th>
                                    <th>Estado</th>
                                    <th>Fecha</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody id="historialTableBody">
                                <!-- Dinámico -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- VISTA: CONFIGURACIÓN -->
            <div id="view-configuracion" class="view">
                <div class="card">
                    <div class="config-tabs">
                        <button class="tab-btn active" onclick="switchConfigTab('tab-marcas')">Marcas</button>
                        <button class="tab-btn" onclick="switchConfigTab('tab-modelos')">Modelos</button>
                        <button class="tab-btn" onclick="switchConfigTab('tab-accesorios')">Accesorios</button>
                        <button class="tab-btn" onclick="switchConfigTab('tab-taller')">Datos Taller</button>
                    </div>

                    <div id="tab-marcas" class="tab-content active">
                        <h4 style="margin-bottom:1rem;">Gestionar Marcas</h4>
                        <div id="configMarcasList"></div>
                        <div class="config-item" style="margin-top:1rem;">
                            <input type="text" id="newMarcaInput" placeholder="Nueva marca">
                            <button class="btn-icon add" onclick="addMarca()"><i data-lucide="plus"></i></button>
                        </div>
                    </div>

                    <div id="tab-modelos" class="tab-content">
                        <h4 style="margin-bottom:1rem;">Gestionar Modelos por Marca</h4>
                        <div class="form-group" style="margin-bottom:1rem;max-width:300px;">
                            <select id="configMarcaSelect" onchange="renderConfigModelos()">
                                <option value="">Seleccione marca...</option>
                            </select>
                        </div>
                        <div id="configModelosList"></div>
                        <div class="config-item" style="margin-top:1rem;">
                            <input type="text" id="newModeloInput" placeholder="Nuevo modelo">
                            <button class="btn-icon add" onclick="addModelo()"><i data-lucide="plus"></i></button>
                        </div>
                    </div>

                    <div id="tab-accesorios" class="tab-content">
                        <h4 style="margin-bottom:1rem;">Gestionar Categorías y Accesorios</h4>
                        <div id="configAccesoriosList"></div>
                        <div class="config-item" style="margin-top:1rem;">
                            <input type="text" id="newCategoriaInput" placeholder="Nueva categoría">
                            <button class="btn-icon add" onclick="addCategoria()"><i data-lucide="plus"></i></button>
                        </div>
                    </div>

                    <div id="tab-taller" class="tab-content">
                        <h4 style="margin-bottom:1rem;">Información del Taller</h4>
                        <div class="form-grid grid-2">
                            <div class="form-group">
                                <label>Teléfono</label>
                                <input type="text" id="configTelefono" value="+56 9 4043 5805">
                            </div>
                            <div class="form-group">
                                <label>Dirección</label>
                                <input type="text" id="configDireccion" value="La Trilla 1062, San Bernardo">
                            </div>
                        </div>
                        <button class="btn btn-primary" style="margin-top:1rem;" onclick="saveTallerConfig()">
                            <i data-lucide="save"></i> Guardar Cambios
                        </button>
                    </div>
                    
                    <div style="margin-top:2rem;padding-top:1rem;border-top:1px solid var(--border);">
                        <button class="btn btn-danger" onclick="clearDatabase()">
                            <i data-lucide="trash-2"></i> Borrar Toda la Base de Datos Local
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </main>
</div>

<!-- ÁREA DE IMPRESIÓN (Oculta) -->
<div id="printArea"></div>

<script>
    // ==========================================
    // 1. CONFIGURACIÓN DE FIREBASE (¡REEMPLAZA ESTO!)
    // ==========================================
    const firebaseConfig = {
        apiKey: "TU_API_KEY_AQUI",
        authDomain: "TU_PROYECTO.firebaseapp.com",
        projectId: "TU_PROYECTO",
        storageBucket: "TU_PROYECTO.appspot.com",
        messagingSenderId: "TU_SENDER_ID",
        appId: "TU_APP_ID"
    };

    let db = null; // Firestore instance
    let isFirebaseReady = false;

    // Intentar inicializar Firebase
    try {
        if (firebaseConfig.apiKey !== "TU_API_KEY_AQUI" && window.firebaseApp) {
            const { initializeApp, getFirestore } = window.firebaseApp;
            const app = initializeApp(firebaseConfig);
            db = getFirestore(app);
            isFirebaseReady = true;
            console.log("✅ Firebase conectado correctamente");
        } else {
            console.warn("⚠️ Firebase no configurado. Usando modo local (IndexedDB).");
        }
    } catch (e) {
        console.error("Error al inicializar Firebase:", e);
    }

    // ==========================================
    // 2. CONSTANTES Y ESTADO
    // ==========================================
    const DB_NAME = "fueltek_db_v3";
    const DB_VERSION = 1;
    const STORE = "orders";
    const CONFIG_KEY = "fueltek_config_v3";
    const OT_KEY = "fueltek_last_ot_v3";

    let currentLoadedOt = null;
    let lastKnownOt = 10724;
    let allOrders = [];

    const defaultConfig = {
        marcas: ['STIHL', 'HUSQVARNA', 'MAKITA', 'ECHO', 'CHAMPION'],
        modelos: {
            'STIHL': ['MS 180', 'MS 211', 'MS 250', 'MS 261', 'MS 362', 'MS 462'],
            'HUSQVARNA': ['137', '142', '236', '240', '353', '359', '365', '372'],
            'MAKITA': ['EA3200', 'EA4300', 'EA5000', 'EA6100'],
            'ECHO': ['CS-2511', 'CS-310', 'CS-352', 'CS-400', 'CS-490'],
            'CHAMPION': ['38cc', '42cc', '45cc', '52cc', '58cc']
        },
        accesorios: {
            'Herramientas': ['Motosierra', 'Desbrozadora', 'Cortasetos', 'Corta Césped', 'Fumigadora', 'Sopladora'],
            'Partes Motosierra': ['Espada', 'Cadena', 'Piñón', 'Filtro de Aire', 'Filtro de Combustible', 'Bujía'],
            'Motor': ['Pistón', 'Cilindro', 'Cárter', 'Cigüeñal', 'Retenes', 'Carburador'],
            'Sistema de Arranque': ['Cuerda de Arranque', 'Polea de Arranque', 'Resorte', 'Tapa de Arranque', 'Manilla'],
            'Accesorios Adicionales': ['Funda Espada', 'Aceite de Cadena', 'Mezcla 2T', 'Lima', 'Destornillador']
        },
        taller: {
            telefono: '+56 9 4043 5805',
            direccion: 'La Trilla 1062, San Bernardo'
        }
    };

    // ==========================================
    // 3. INICIALIZACIÓN
    // ==========================================
    document.addEventListener('DOMContentLoaded', async () => {
        await initDB();
        await loadConfig();
        await updateOtDisplay();
        setupEventListeners();
        lucide.createIcons();
        updateSyncStatus();
        
        // Cargar datos para el dashboard
        await loadDashboard();
        
        // Establecer fecha de hoy por defecto
        const fechaInput = document.querySelector('[name="fechaRecibida"]');
        if (fechaInput && !fechaInput.value) {
            fechaInput.valueAsDate = new Date();
        }
    });

    function updateSyncStatus() {
        const dot = document.getElementById('syncDot');
        const text = document.getElementById('syncText');
        if (isFirebaseReady) {
            dot.classList.add('online');
            text.textContent = 'Sincronizado con Nube';
            text.style.color = '#10b981';
        } else {
            dot.classList.remove('online');
            text.textContent = 'Modo Local (Sin Firebase)';
            text.style.color = '#f59e0b';
        }
    }

    // ==========================================
    // 4. INDEXEDDB
    // ==========================================
    function initDB() {
        return new Promise((resolve, reject) => {
            const req = indexedDB.open(DB_NAME, DB_VERSION);
            req.onupgradeneeded = e => {
                const db = e.target.result;
                if (!db.objectStoreNames.contains(STORE)) {
                    db.createObjectStore(STORE, { keyPath: "ot" });
                }
            };
            req.onsuccess = () => resolve(req.result);
            req.onerror = () => reject(req.error);
        });
    }

    function dbPut(order) {
        return new Promise((resolve, reject) => {
            const req = indexedDB.open(DB_NAME, DB_VERSION);
            req.onsuccess = e => {
                const db = e.target.result;
                const tx = db.transaction(STORE, 'readwrite');
                const store = tx.objectStore(STORE);
                const r = store.put(order);
                r.onsuccess = () => { resolve(true); db.close(); };
                r.onerror = () => { reject(r.error); db.close(); };
            };
        });
    }

    function dbGetAll() {
        return new Promise((resolve, reject) => {
            const req = indexedDB.open(DB_NAME, DB_VERSION);
            req.onsuccess = e => {
                const db = e.target.result;
                const tx = db.transaction(STORE, 'readonly');
                const store = tx.objectStore(STORE);
                const r = store.getAll();
                r.onsuccess = () => { resolve(r.result || []); db.close(); };
                r.onerror = () => { reject(r.error); db.close(); };
            };
        });
    }

    function dbDelete(key) {
        return new Promise((resolve, reject) => {
            const req = indexedDB.open(DB_NAME, DB_VERSION);
            req.onsuccess = e => {
                const db = e.target.result;
                const tx = db.transaction(STORE, 'readwrite');
                const store = tx.objectStore(STORE);
                const r = store.delete(String(key));
                r.onsuccess = () => { resolve(true); db.close(); };
                r.onerror = () => { reject(r.error); db.close(); };
            };
        });
    }

    // ==========================================
    // 5. FIREBASE SYNC
    // ==========================================
    async function syncToFirebase(order) {
        if (!isFirebaseReady || !db) return;
        try {
            const { collection, doc, setDoc } = window.firebaseApp;
            await setDoc(doc(db, "orders", String(order.ot)), order);
            // Actualizar contador global
            await setDoc(doc(db, "config", "lastOt"), { value: lastKnownOt });
        } catch (e) {
            console.error("Error sync Firebase:", e);
        }
    }

    async function getOrdersFromCloud() {
        if (!isFirebaseReady || !db) return null;
        try {
            const { collection, getDocs } = window.firebaseApp;
            const querySnapshot = await getDocs(collection(db, "orders"));
            return querySnapshot.docs.map(doc => doc.data());
        } catch (e) {
            console.error("Error fetch Firebase:", e);
            return null;
        }
    }

    // ==========================================
    // 6. CONFIGURACIÓN Y UI
    // ==========================================
    async function loadConfig() {
        const saved = localStorage.getItem(CONFIG_KEY);
        const config = saved ? JSON.parse(saved) : defaultConfig;
        if (!saved) localStorage.setItem(CONFIG_KEY, JSON.stringify(defaultConfig));

        // Cargar años (1980-2030)
        const anioSelect = document.getElementById('anioSelect');
        anioSelect.innerHTML = '<option value="">Seleccione...</option>';
        for (let y = 1980; y <= 2030; y++) {
            anioSelect.innerHTML += `<option value="${y}">${y}</option>`;
        }

        // Cargar marcas
        loadMarcasToSelects(config.marcas);
        
        // Cargar accesorios
        renderAccessoriesUI(config.accesorios);
        
        // Cargar datos taller
        if (config.taller) {
            document.getElementById('configTelefono').value = config.taller.telefono || '';
            document.getElementById('configDireccion').value = config.taller.direccion || '';
        }
    }

    function loadMarcasToSelects(marcas) {
        const marcaSelect = document.getElementById('marcaSelect');
        const configMarcaSelect = document.getElementById('configMarcaSelect');
        
        marcaSelect.innerHTML = '<option value="">Seleccione...</option>';
        configMarcaSelect.innerHTML = '<option value="">Seleccione marca...</option>';
        
        marcas.forEach(m => {
            marcaSelect.innerHTML += `<option value="${m}">${m}</option>`;
            configMarcaSelect.innerHTML += `<option value="${m}">${m}</option>`;
        });

        marcaSelect.addEventListener('change', function() {
            loadModelosSelect(this.value);
        });
    }

    function loadModelosSelect(marca) {
        const config = JSON.parse(localStorage.getItem(CONFIG_KEY));
        const modeloSelect = document.getElementById('modeloSelect');
        const modelos = config.modelos[marca] || [];
        
        modeloSelect.innerHTML = '<option value="">Seleccione...</option>';
        modelos.forEach(m => {
            modeloSelect.innerHTML += `<option value="${m}">${m}</option>`;
        });
    }

    function renderAccessoriesUI(accesorios) {
        const container = document.getElementById('accessoriesContainer');
        container.innerHTML = '';
        
        Object.keys(accesorios).forEach(cat => {
            const div = document.createElement('div');
            div.className = 'accessory-category';
            div.innerHTML = `
                <div class="acc-header" onclick="this.nextElementSibling.classList.toggle('active')">
                    <span>${cat}</span>
                    <i data-lucide="chevron-down" style="width:16px;height:16px;"></i>
                </div>
                <div class="acc-body">
                    <div class="checkbox-grid">
                        ${accesorios[cat].map(item => `
                            <label class="checkbox-item">
                                <input type="checkbox" name="accesorios" value="${item}">
                                <span>${item}</span>
                            </label>
                        `).join('')}
                    </div>
                </div>
            `;
            container.appendChild(div);
        });
        lucide.createIcons();
    }

    // ==========================================
    // 7. FORMATO Y LÓGICA DE FORMULARIO
    // ==========================================
    function formatCLP(num) {
        if (num === null || num === undefined) return "0";
        const n = String(num).replace(/[^\d]/g, '');
        if (n === "") return "";
        return new Intl.NumberFormat('es-CL').format(Number(n));
    }

    function unformatCLP(str) {
        if (!str) return 0;
        const cleaned = String(str).replace(/[^\d]/g, '');
        return parseInt(cleaned, 10) || 0;
    }

    function handleFormatOnInput(e) {
        const input = e.target;
        const numericValue = unformatCLP(input.value);
        input.value = formatCLP(numericValue);
        updateSaldo();
    }

    function updateSaldo() {
        const valorInput = document.getElementById('valorTrabajoInput');
        const abonoInput = document.getElementById('montoAbonadoInput');
        const estadoPago = document.getElementById('estadoPago');
        const labelAbonoGroup = document.getElementById('labelAbonoGroup');
        const saldoDisplay = document.getElementById('saldoDisplay');
        const saldoValue = document.getElementById('saldoValue');

        const valor = unformatCLP(valorInput.value);
        const estado = estadoPago.value;

        if (estado === 'Abonado') {
            labelAbonoGroup.style.display = 'flex';
        } else if (estado === 'Pagado') {
            labelAbonoGroup.style.display = 'none';
            abonoInput.value = formatCLP(valor);
        } else {
            labelAbonoGroup.style.display = 'none';
            abonoInput.value = '';
        }

        const abono = unformatCLP(abonoInput.value);
        const saldo = valor - abono;

        if (estado === 'Pagado' || saldo <= 0) {
            saldoDisplay.style.display = 'none';
        } else {
            saldoDisplay.style.display = 'block';
            saldoDisplay.className = 'saldo-box pending';
            saldoValue.textContent = formatCLP(saldo);
        }
    }

    function setupEventListeners() {
        document.getElementById('valorTrabajoInput').addEventListener('input', handleFormatOnInput);
        document.getElementById('montoAbonadoInput').addEventListener('input', handleFormatOnInput);
        document.getElementById('estadoPago').addEventListener('change', updateSaldo);
        
        document.getElementById('searchHistorial').addEventListener('input', (e) => {
            renderHistorial(e.target.value);
        });
    }

    // ==========================================
    // 8. CORRELATIVO
    // ==========================================
    async function updateOtDisplay() {
        const saved = localStorage.getItem(OT_KEY);
        lastKnownOt = saved ? parseInt(saved) : 10724;
        
        // Si hay Firebase, intentar obtener el último de la nube
        if (isFirebaseReady) {
            try {
                const { doc, getDoc } = window.firebaseApp;
                const docRef = doc(db, "config", "lastOt");
                const docSnap = await getDoc(docRef);
                if (docSnap.exists()) {
                    const cloudOt = docSnap.data().value;
                    if (cloudOt > lastKnownOt) {
                        lastKnownOt = cloudOt;
                        localStorage.setItem(OT_KEY, String(lastKnownOt));
                    }
                }
            } catch (e) {
                console.warn("Usando correlativo local");
            }
        }
        
        document.getElementById('nextOtDisplay').textContent = String(lastKnownOt + 1);
    }

    // ==========================================
    // 9. GUARDAR / CARGAR / ELIMINAR
    // ==========================================
    async function saveOrder() {
        const form = document.getElementById('otForm');
        if (!form.checkValidity()) {
            form.reportValidity();
            return;
        }

        const fd = new FormData(form);
        const order = {};
        for (const [k, v] of fd.entries()) {
            if (k !== 'accesorios') order[k] = v;
        }
        
        order.accesorios = Array.from(form.querySelectorAll('input[name="accesorios"]:checked')).map(c => c.value);
        order.fechaGuardado = new Date().toISOString();
        order.valorTrabajo = unformatCLP(order.valorTrabajo);
        order.estadoPago = order.estadoPago || 'Pendiente';
        order.montoAbonado = unformatCLP(order.montoAbonado);

        if (order.montoAbonado > order.valorTrabajo && order.estadoPago !== 'Pagado') {
            alert('Error: El monto abonado no puede ser mayor que el valor del trabajo.');
            return;
        }

        let otToSave;
        let isNew = false;

        if (currentLoadedOt) {
            order.ot = String(currentLoadedOt);
            otToSave = currentLoadedOt;
        } else {
            otToSave = String(lastKnownOt + 1);
            order.ot = otToSave;
            isNew = true;
        }

        try {
            await dbPut(order);
            await syncToFirebase(order); // Intentar sync

            if (isNew) {
                lastKnownOt = Number(otToSave);
                localStorage.setItem(OT_KEY, String(lastKnownOt));
            }

            alert(`Orden ${currentLoadedOt ? 'actualizada' : 'guardada'} correctamente ✅ (OT #${otToSave})`);
            resetForm();
            await loadDashboard(); // Actualizar stats
        } catch (err) {
            alert(`Error al guardar: ${err}`);
        }
    }

    async function loadDashboard() {
        const cloudData = await getOrdersFromCloud();
        allOrders = cloudData || await dbGetAll();
        
        // Stats
        const total = allOrders.length;
        const pending = allOrders.filter(o => o.estadoPago === 'Pendiente').length;
        const revenue = allOrders
            .filter(o => o.estadoPago === 'Pagado' || o.estadoPago === 'Abonado')
            .reduce((sum, o) => sum + (o.valorTrabajo || 0), 0);

        document.getElementById('statTotal').textContent = total;
        document.getElementById('statPending').textContent = pending;
        document.getElementById('statRevenue').textContent = '$' + formatCLP(revenue);

        // Recent table
        const recent = [...allOrders].sort((a, b) => Number(b.ot) - Number(a.ot)).slice(0, 5);
        const tbody = document.getElementById('recentOrdersBody');
        tbody.innerHTML = recent.map(o => `
            <tr>
                <td><strong>#${o.ot}</strong></td>
                <td>${o.clienteNombre}</td>
                <td>${o.marca} ${o.modelo}</td>
                <td><span class="badge ${o.estadoPago === 'Pagado' ? 'badge-paid' : o.estadoPago === 'Abonado' ? 'badge-partial' : 'badge-pending'}">${o.estadoPago}</span></td>
                <td>${o.fechaRecibida}</td>
            </tr>
        `).join('');
        
        if (recent.length === 0) {
            tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;padding:2rem;color:var(--text-muted);">No hay órdenes registradas</td></tr>';
        }
    }

    function renderHistorial(filter = '') {
        const tbody = document.getElementById('historialTableBody');
        const filtered = allOrders.filter(o => {
            if (!filter) return true;
            const f = filter.toLowerCase();
            return String(o.ot).includes(f) || 
                   (o.clienteNombre && o.clienteNombre.toLowerCase().includes(f)) ||
                   (o.marca && o.marca.toLowerCase().includes(f));
        }).sort((a, b) => Number(b.ot) - Number(a.ot));

        tbody.innerHTML = filtered.map(o => `
            <tr>
                <td><strong>#${o.ot}</strong></td>
                <td>${o.clienteNombre}<br><small style="color:var(--text-muted)">${o.clienteTelefono}</small></td>
                <td>${o.marca} ${o.modelo}</td>
                <td>$${formatCLP(o.valorTrabajo)}</td>
                <td><span class="badge ${o.estadoPago === 'Pagado' ? 'badge-paid' : o.estadoPago === 'Abonado' ? 'badge-partial' : 'badge-pending'}">${o.estadoPago}</span></td>
                <td>${o.fechaRecibida}</td>
                <td>
                    <div class="action-btns">
                        <button class="action-btn" onclick="loadOrder('${o.ot}')" title="Editar"><i data-lucide="edit-3"></i></button>
                        <button class="action-btn" onclick="printOrder('${o.ot}')" title="Imprimir"><i data-lucide="printer"></i></button>
                        <button class="action-btn delete" onclick="deleteOrder('${o.ot}')" title="Eliminar"><i data-lucide="trash-2"></i></button>
                    </div>
                </td>
            </tr>
        `).join('');
        
        if (filtered.length === 0) {
            tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;padding:2rem;color:var(--text-muted);">No se encontraron resultados</td></tr>';
        }
        lucide.createIcons();
    }

    async function loadOrder(ot) {
        const order = allOrders.find(o => String(o.ot) === String(ot));
        if (!order) return;

        currentLoadedOt = String(order.ot);
        switchView('nueva-ot');
        
        const form = document.getElementById('otForm');
        form.reset();

        // Llenar campos
        Object.keys(order).forEach(key => {
            if (key === 'accesorios') {
                form.querySelectorAll('input[name="accesorios"]').forEach(cb => {
                    cb.checked = order.accesorios.includes(cb.value);
                });
            } else if (key !== 'ot' && key !== 'fechaGuardado') {
                const el = form.querySelector(`[name="${key}"]`);
                if (el) {
                    if (key === 'valorTrabajo' || key === 'montoAbonado') {
                        el.value = formatCLP(order[key]);
                    } else {
                        el.value = order[key];
                    }
                }
            }
        });

        if (order.marca) {
            document.getElementById('marcaSelect').value = order.marca;
            loadModelosSelect(order.marca);
            setTimeout(() => {
                if (order.modelo) document.getElementById('modeloSelect').value = order.modelo;
            }, 100);
        }

        updateSaldo();
        lucide.createIcons();
        window.scrollTo(0, 0);
    }

    async function deleteOrder(ot) {
        if (!confirm(`¿Eliminar definitivamente la OT #${ot}?`)) return;
        
        await dbDelete(ot);
        if (isFirebaseReady) {
            try {
                const { doc, deleteDoc } = window.firebaseApp;
                await deleteDoc(doc(db, "orders", String(ot)));
            } catch(e) {}
        }
        
        alert('Orden eliminada');
        currentLoadedOt = null;
        await loadDashboard();
        renderHistorial();
    }

    function resetForm() {
        document.getElementById('otForm').reset();
        currentLoadedOt = null;
        document.getElementById('labelAbonoGroup').style.display = 'none';
        document.getElementById('saldoDisplay').style.display = 'none';
        updateOtDisplay();
        lucide.createIcons();
    }

    // ==========================================
    // 10. IMPRESIÓN
    // ==========================================
    function printOrder(ot) {
        const order = allOrders.find(o => String(o.ot) === String(ot));
        if (order) buildAndPrint(order);
    }

    function buildAndPrint(data) {
        const printArea = document.getElementById('printArea');
        const config = JSON.parse(localStorage.getItem(CONFIG_KEY));
        
        const valorNum = data.valorTrabajo || 0;
        const abonoNum = data.montoAbonado || 0;
        const saldo = data.estadoPago === 'Pagado' ? 0 : valorNum - abonoNum;
        const estadoColor = data.estadoPago === 'Pagado' ? '#10b981' : data.estadoPago === 'Abonado' ? '#f59e0b' : '#ef4444';

        const html = `
            <div style="font-family:'Inter',sans-serif;color:#111;padding-bottom:15px;">
                <div style="display:flex;align-items:center;gap:20px;border-bottom:3px solid #2563eb;padding-bottom:15px;margin-bottom:20px;">
                    <img src="logo-fueltek.png" style="width:90px;height:90px;object-fit:contain;" alt="logo" onerror="this.style.display='none'">
                    <div style="flex-grow:1;">
                        <h2 style="margin:0;color:#2563eb;font-size:22px;font-weight:800;">ORDEN DE TRABAJO - FUELTEK</h2>
                        <div style="color:#f97316;font-weight:700;font-size:14px;margin-top:4px;">Servicio Técnico Multimarca Profesional</div>
                        <div style="font-size:12px;margin-top:6px;color:#64748b;">
                            Tel: ${config.taller.telefono} | ${config.taller.direccion}
                        </div>
                    </div>
                    <div style="text-align:right;background:#0f172a;color:white;padding:12px 16px;border-radius:8px;">
                        <div style="font-weight:800;font-size:20px;">N° OT: ${data.ot}</div>
                        <div style="font-size:11px;margin-top:4px;opacity:0.8;">${new Date().toLocaleDateString('es-CL')}</div>
                    </div>
                </div>
                
                <table style="width:100%;border-collapse:collapse;margin-bottom:20px;font-size:10pt;">
                    <tr>
                        <td style="width:50%;padding:12px;background:#f8fafc;border-radius:6px;vertical-align:top;">
                            <strong style="color:#2563eb;display:block;margin-bottom:8px;font-size:11pt;">DATOS DEL CLIENTE</strong>
                            <span style="display:block;margin-bottom:4px;"><strong>Nombre:</strong> ${data.clienteNombre || '-'}</span>
                            <span style="display:block;margin-bottom:4px;"><strong>Teléfono:</strong> ${data.clienteTelefono || '-'}</span>
                            <span style="display:block;margin-bottom:4px;"><strong>Email:</strong> ${data.clienteEmail || '-'}</span>
                            <span style="display:block;"><strong>Recepción:</strong> ${data.fechaRecibida || '-'} | <strong>Entrega:</strong> ${data.fechaEntrega || '-'}</span>
                        </td>
                        <td style="width:50%;padding:12px;background:#f8fafc;border-radius:6px;vertical-align:top;padding-left:20px;">
                            <strong style="color:#2563eb;display:block;margin-bottom:8px;font-size:11pt;">EQUIPO / HERRAMIENTA</strong>
                            <span style="display:block;margin-bottom:4px;"><strong>Marca:</strong> ${data.marca || '-'}</span>
                            <span style="display:block;margin-bottom:4px;"><strong>Modelo:</strong> ${data.modelo || '-'}</span>
                            <span style="display:block;margin-bottom:4px;"><strong>N° Serie:</strong> ${data.serie || '-'}</span>
                            <span style="display:block;"><strong>Año:</strong> ${data.anio || '-'}</span>
                        </td>
                    </tr>
                </table>

                <div style="display:flex;gap:20px;margin-bottom:20px;">
                    <div style="width:40%;background:#f8fafc;padding:12px;border-radius:6px;border:1px solid #e2e8f0;">
                        <strong style="color:#2563eb;display:block;margin-bottom:8px;font-size:11pt;">RESUMEN FINANCIERO</strong>
                        <table style="width:100%;font-size:9.5pt;">
                            <tr><td style="padding:4px 0;">Valor Trabajo:</td><td style="text-align:right;font-weight:700;">$${formatCLP(valorNum)}</td></tr>
                            ${data.estadoPago !== 'Pendiente' ? `<tr><td style="padding:4px 0;">Abonado:</td><td style="text-align:right;">$${formatCLP(abonoNum)}</td></tr>` : ''}
                            <tr><td style="padding:4px 0;border-top:1px solid #cbd5e1;margin-top:4px;">Estado:</td><td style="text-align:right;font-weight:700;color:${estadoColor};">${data.estadoPago}</td></tr>
                            ${saldo > 0 ? `<tr><td style="padding:6px 0;border-top:2px solid #ef4444;margin-top:6px;font-weight:800;color:#ef4444;">SALDO:</td><td style="text-align:right;font-weight:800;color:#ef4444;font-size:11pt;">$${formatCLP(saldo)}</td></tr>` : ''}
                        </table>
                    </div>
                    <div style="flex:1;background:#f8fafc;padding:12px;border-radius:6px;border:1px solid #e2e8f0;">
                        <strong style="color:#2563eb;display:block;margin-bottom:8px;font-size:11pt;">ACCESORIOS RECIBIDOS</strong>
                        <div style="display:flex;flex-wrap:wrap;gap:6px;">
                            ${(data.accesorios || []).map(s => `<span style="background:white;border:1px solid #cbd5e1;padding:4px 8px;border-radius:4px;font-size:9px;font-weight:500;">${s}</span>`).join('') || '<span style="color:#94a3b8;font-style:italic;">Ninguno declarado</span>'}
                        </div>
                    </div>
                </div>

                <div style="margin-bottom:15px;">
                    <strong style="color:#2563eb;font-size:11pt;">DIAGNÓSTICO INICIAL</strong>
                    <div style="border:1px solid #e2e8f0;padding:10px;border-radius:6px;min-height:60px;background:#fcfcfc;font-size:9.5pt;margin-top:6px;">${data.diagnostico || 'Sin diagnóstico'}</div>
                </div>

                <div style="margin-bottom:30px;">
                    <strong style="color:#2563eb;font-size:11pt;">TRABAJO REALIZADO</strong>
                    <div style="border:1px solid #e2e8f0;padding:10px;border-radius:6px;min-height:60px;background:#fcfcfc;font-size:9.5pt;margin-top:6px;">${data.trabajo || 'Pendiente'}</div>
                </div>

                <div style="display:flex;gap:60px;margin-top:40px;padding-top:20px;border-top:2px solid #e2e8f0;">
                    <div style="flex:1;text-align:center;position:relative;">
                        <img src="stamp-motosierra.png" style="width:130px;height:130px;position:absolute;top:-65px;left:50%;transform:translateX(-50%);opacity:0.9;" alt="sello" onerror="this.style.display='none'">
                        <div style="height:1px;border-bottom:2px solid #0f172a;margin:0 auto;width:70%;margin-top:40px;"></div>
                        <div style="margin-top:8px;font-weight:700;color:#0f172a;font-size:10pt;">Firma Taller</div>
                        <div style="font-size:9pt;color:#64748b;">${data.firmaTaller || ''}</div>
                    </div>
                    <div style="flex:1;text-align:center;">
                        <div style="height:1px;border-bottom:2px solid #0f172a;margin:0 auto;width:70%;"></div>
                        <div style="margin-top:8px;font-weight:700;color:#0f172a;font-size:10pt;">Firma Cliente</div>
                        <div style="font-size:9pt;color:#64748b;">${data.firmaCliente || ''}</div>
                    </div>
                </div>

                <div style="margin-top:40px;padding:12px;background:#eff6ff;border:1px solid #bfdbfe;border-radius:6px;font-size:9pt;color:#1e40af;">
                    <strong>Notas Importantes:</strong>
                    <ul style="margin:6px 0 0 18px;padding:0;">
                        <li>Herramienta no retirada en 30 días genera cobro por almacenamiento.</li>
                        <li>FuelTek no se responsabiliza por accesorios no declarados al momento de la recepción.</li>
                        <li>El cliente autoriza la revisión del equipo y acepta los términos del servicio.</li>
                    </ul>
                </div>
            </div>
        `;
        
        printArea.innerHTML = html;
        printArea.style.display = 'block';
        window.print();
        setTimeout(() => printArea.style.display = 'none', 800);
    }

    // ==========================================
    // 11. EXPORTAR Y LIMPIAR
    // ==========================================
    function exportToExcel() {
        if (allOrders.length === 0) return alert("No hay datos para exportar");
        
        const data = allOrders.map(o => ({
            'N° OT': o.ot,
            'Cliente': o.clienteNombre,
            'Teléfono': o.clienteTelefono,
            'Marca': o.marca,
            'Modelo': o.modelo,
            'Valor Trabajo': o.valorTrabajo,
            'Estado': o.estadoPago,
            'Monto Abonado': o.montoAbonado,
            'Fecha': o.fechaRecibida
        }));

        const ws = XLSX.utils.json_to_sheet(data);
        const wb = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(wb, ws, "Órdenes");
        XLSX.writeFile(wb, `FuelTek_OT_${new Date().toISOString().slice(0,10)}.xlsx`);
    }

    async function clearDatabase() {
        if (!confirm("⚠️ ¿ESTÁ SEGURO? Esto eliminará TODAS las órdenes locales y reiniciará el contador a 10725.")) return;
        
        const req = indexedDB.deleteDatabase(DB_NAME);
        req.onsuccess = async () => {
            localStorage.removeItem(OT_KEY);
            lastKnownOt = 10724;
            await initDB();
            await updateOtDisplay();
            allOrders = [];
            await loadDashboard();
            renderHistorial();
            alert("Base de datos local eliminada correctamente.");
        };
    }

    // ==========================================
    // 12. CONFIGURACIÓN AVANZADA
    // ==========================================
    function switchConfigTab(tabId) {
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
        
        event.target.classList.add('active');
        document.getElementById(tabId).classList.add('active');
        
        if (tabId === 'tab-marcas') renderConfigMarcas();
        if (tabId === 'tab-modelos') renderConfigModelos();
        if (tabId === 'tab-accesorios') renderConfigAccesorios();
        lucide.createIcons();
    }

    function renderConfigMarcas() {
        const config = JSON.parse(localStorage.getItem(CONFIG_KEY));
        document.getElementById('configMarcasList').innerHTML = config.marcas.map((m, i) => `
            <div class="config-item">
                <input type="text" value="${m}" onchange="updateMarca(${i}, this.value)">
                <button class="btn-icon remove" onclick="removeMarca(${i})"><i data-lucide="trash-2"></i></button>
            </div>
        `).join('');
        lucide.createIcons();
    }

    function addMarca() {
        const input = document.getElementById('newMarcaInput');
        const val = input.value.trim();
        if (!val) return;
        const config = JSON.parse(localStorage.getItem(CONFIG_KEY));
        if (!config.marcas.includes(val)) {
            config.marcas.push(val);
            config.modelos[val] = [];
            localStorage.setItem(CONFIG_KEY, JSON.stringify(config));
            loadMarcasToSelects(config.marcas);
            renderConfigMarcas();
            input.value = '';
        }
    }

    function updateMarca(idx, val) {
        const config = JSON.parse(localStorage.getItem(CONFIG_KEY));
        const old = config.marcas[idx];
        config.marcas[idx] = val;
        config.modelos[val] = config.modelos[old];
        delete config.modelos[old];
        localStorage.setItem(CONFIG_KEY, JSON.stringify(config));
        loadMarcasToSelects(config.marcas);
    }

    function removeMarca(idx) {
        const config = JSON.parse(localStorage.getItem(CONFIG_KEY));
        const m = config.marcas[idx];
        config.marcas.splice(idx, 1);
        delete config.modelos[m];
        localStorage.setItem(CONFIG_KEY, JSON.stringify(config));
        loadMarcasToSelects(config.marcas);
        renderConfigMarcas();
    }

    function renderConfigModelos() {
        const config = JSON.parse(localStorage.getItem(CONFIG_KEY));
        const marca = document.getElementById('configMarcaSelect').value;
        const container = document.getElementById('configModelosList');
        
        if (!marca) {
            container.innerHTML = '<p style="color:var(--text-muted);">Seleccione una marca</p>';
            return;
        }
        
        const modelos = config.modelos[marca] || [];
        container.innerHTML = modelos.map((m, i) => `
            <div class="config-item">
                <input type="text" value="${m}" onchange="updateModelo('${marca}', ${i}, this.value)">
                <button class="btn-icon remove" onclick="removeModelo('${marca}', ${i})"><i data-lucide="trash-2"></i></button>
            </div>
        `).join('');
        lucide.createIcons();
    }

    function addModelo() {
        const marca = document.getElementById('configMarcaSelect').value;
        const input = document.getElementById('newModeloInput');
        const val = input.value.trim();
        if (!marca || !val) return;
        
        const config = JSON.parse(localStorage.getItem(CONFIG_KEY));
        if (!config.modelos[marca]) config.modelos[marca] = [];
        if (!config.modelos[marca].includes(val)) {
            config.modelos[marca].push(val);
            localStorage.setItem(CONFIG_KEY, JSON.stringify(config));
            renderConfigModelos();
            input.value = '';
        }
    }

    function updateModelo(marca, idx, val) {
        const config = JSON.parse(localStorage.getItem(CONFIG_KEY));
        config.modelos[marca][idx] = val;
        localStorage.setItem(CONFIG_KEY, JSON.stringify(config));
    }

    function removeModelo(marca, idx) {
        const config = JSON.parse(localStorage.getItem(CONFIG_KEY));
        config.modelos[marca].splice(idx, 1);
        localStorage.setItem(CONFIG_KEY, JSON.stringify(config));
        renderConfigModelos();
    }

    function renderConfigAccesorios() {
        const config = JSON.parse(localStorage.getItem(CONFIG_KEY));
        const container = document.getElementById('configAccesoriosList');
        
        container.innerHTML = Object.keys(config.accesorios).map(cat => `
            <div style="margin-bottom:1.5rem;padding:1rem;background:#f8fafc;border-radius:8px;border:1px solid var(--border);">
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.75rem;">
                    <strong style="color:var(--primary);">${cat}</strong>
                    <button class="btn-icon remove" onclick="removeCategoria('${cat}')" title="Eliminar categoría"><i data-lucide="trash-2"></i></button>
                </div>
                ${config.accesorios[cat].map((item, i) => `
                    <div class="config-item">
                        <input type="text" value="${item}" onchange="updateAccesorio('${cat}', ${i}, this.value)">
                        <button class="btn-icon remove" onclick="removeAccesorio('${cat}', ${i})"><i data-lucide="x"></i></button>
                    </div>
                `).join('')}
                <div class="config-item" style="margin-top:0.75rem;">
                    <input type="text" id="newAcc_${cat.replace(/\s/g,'_')}" placeholder="Nuevo accesorio">
                    <button class="btn-icon add" onclick="addAccesorio('${cat}')"><i data-lucide="plus"></i></button>
                </div>
            </div>
        `).join('');
        lucide.createIcons();
    }

    function addCategoria() {
        const input = document.getElementById('newCategoriaInput');
        const val = input.value.trim();
        if (!val) return;
        const config = JSON.parse(localStorage.getItem(CONFIG_KEY));
        config.accesorios[val] = [];
        localStorage.setItem(CONFIG_KEY, JSON.stringify(config));
        renderAccessoriesUI(config.accesorios);
        renderConfigAccesorios();
        input.value = '';
    }

    function removeCategoria(cat) {
        const config = JSON.parse(localStorage.getItem(CONFIG_KEY));
        delete config.accesorios[cat];
        localStorage.setItem(CONFIG_KEY, JSON.stringify(config));
        renderAccessoriesUI(config.accesorios);
        renderConfigAccesorios();
    }

    function addAccesorio(cat) {
        const input = document.getElementById(`newAcc_${cat.replace(/\s/g,'_')}`);
        const val = input.value.trim();
        if (!val) return;
        const config = JSON.parse(localStorage.getItem(CONFIG_KEY));
        if (!config.accesorios[cat].includes(val)) {
            config.accesorios[cat].push(val);
            localStorage.setItem(CONFIG_KEY, JSON.stringify(config));
            renderAccessoriesUI(config.accesorios);
            renderConfigAccesorios();
            input.value = '';
        }
    }

    function updateAccesorio(cat, idx, val) {
        const config = JSON.parse(localStorage.getItem(CONFIG_KEY));
        config.accesorios[cat][idx] = val;
        localStorage.setItem(CONFIG_KEY, JSON.stringify(config));
        renderAccessoriesUI(config.accesorios);
    }

    function removeAccesorio(cat, idx) {
        const config = JSON.parse(localStorage.getItem(CONFIG_KEY));
        config.accesorios[cat].splice(idx, 1);
        localStorage.setItem(CONFIG_KEY, JSON.stringify(config));
        renderAccessoriesUI(config.accesorios);
        renderConfigAccesorios();
    }

    function saveTallerConfig() {
        const config = JSON.parse(localStorage.getItem(CONFIG_KEY));
        config.taller.telefono = document.getElementById('configTelefono').value;
        config.taller.direccion = document.getElementById('configDireccion').value;
        localStorage.setItem(CONFIG_KEY, JSON.stringify(config));
        alert('Datos del taller actualizados');
    }

    // ==========================================
    // 13. NAVEGACIÓN
    // ==========================================
    function switchView(viewName) {
        document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
        document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
        
        document.getElementById(`view-${viewName}`).classList.add('active');
        
        // Actualizar título y nav activo
        const titles = {
            'dashboard': 'Dashboard',
            'nueva-ot': currentLoadedOt ? `Editar Orden #${currentLoadedOt}` : 'Nueva Orden de Trabajo',
            'historial': 'Historial de Órdenes',
            'configuracion': 'Configuración del Sistema'
        };
        document.getElementById('viewTitle').textContent = titles[viewName];
        
        // Marcar nav item activo
        const navItems = document.querySelectorAll('.nav-item');
        if (viewName === 'dashboard') navItems[0].classList.add('active');
        if (viewName === 'nueva-ot') navItems[1].classList.add('active');
        if (viewName === 'historial') {
            navItems[2].classList.add('active');
            renderHistorial();
        }
        if (viewName === 'configuracion') {
            navItems[3].classList.add('active');
            renderConfigMarcas();
        }
        
        lucide.createIcons();
    }
</script>

</body>
</html>
